<fieldset class="font-size" data-controller="font-size" data-action="change->font-size#save">
  <legend>文字の大きさ</legend>
  <div class="font-size-options">
    <label><input type="radio" name="font_size" value="standard" data-font-size-target="option" checked> 標準</label>
    <label><input type="radio" name="font_size" value="large" data-font-size-target="option"> 大きめ</label>
  </div>
</fieldset>
