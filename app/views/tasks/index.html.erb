<div class="container mt-4">
  <h1 class="mb-4">タスク一覧</h1>

  <%= link_to "新しいタスクを登録",
      new_task_path,
      class: "btn btn-primary mb-4" %>

  <% if @tasks.empty? %>
    <div class="alert alert-info">
      登録されたタスクはありません。
    </div>
  <% else %>
    <div class="list-group">
      <% @tasks.each do |task| %>
        <div class="list-group-item p-3">

          <h2 class="h4">
            <%= task.title %>
          </h2>

          <p>
            <strong>期限：</strong>
            <%= task.due_date&.strftime("%Y年%m月%d日") || "未設定" %>
          </p>

          <p>
            <strong>優先度：</strong>
            <%= {
              "high" => "高",
              "medium" => "中",
              "low" => "低"
            }[task.priority] || "未設定" %>
          </p>

          <%= link_to "詳細を見る",
              task_path(task),
              class: "btn btn-outline-primary" %>

        </div>
      <% end %>
    </div>
  <% end %>
</div>