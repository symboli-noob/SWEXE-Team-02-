
<h1>タスク登録</h1>

<% if @task.errors.any? %>
  <div>
    <h2>入力内容を確認してください</h2>
    <ul>
      <% @task.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @task, data: { turbo: false } do |f| %>
  <div>
    <%= f.label :title, "タスク名" %>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :description, "タスクの内容" %>
    <%= f.text_area :description %>
  </div>

  <div>
    <%= f.label :due_date, "期限" %>
    <%= f.date_field :due_date %>
  </div>

  <div>
    <%= f.label :priority, "優先度" %>
    <%= f.select :priority, [
      ["高", "high"],
      ["中", "medium"],
      ["低", "low"]
    ] %>
  </div>

  <div>
    <%= f.submit "登録する" %>
  </div>
<% end %>
